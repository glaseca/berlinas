---
import { site } from '../data/site';
---

<section class="section reviews" id="barrio" aria-labelledby="reviews-title">
  <div class="container">
    <div class="reviews__head">
      <div>
        <p class="eyebrow reveal">Lo que se dice en el barrio</p>
        <h2 class="reveal" id="reviews-title" style="--reveal-delay: 60ms">
          Se nota <em>en la calle.</em>
        </h2>
      </div>

      <div class="rating reveal" style="--reveal-delay: 120ms">
        <span class="rating__score">4,9</span>
        <span class="rating__body">
          <span class="rating__stars" aria-hidden="true">★★★★★</span>
          <span class="rating__meta">312 opiniones de ejemplo</span>
        </span>
      </div>
    </div>

    <div class="quotes">
      {site.reviews.map((review, index) => (
        <figure class="quote reveal" style={`--reveal-delay: ${index * 80}ms`}>
          <span class="quote__mark" aria-hidden="true">“</span>
          <blockquote>
            <p>{review.quote}</p>
          </blockquote>
          <figcaption class="quote__author">
            <span class="quote__avatar" aria-hidden="true">{review.initials}</span>
            <span>
              <strong>{review.author}</strong>
              <span class="quote__meta">{review.meta}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="reviews__note reveal">
      Opiniones inventadas para la demostración. Las de verdad, en la barra y con
      un café.
    </p>
  </div>
</section>

<style>
  .reviews {
    position: relative;
    border-block: 1px solid var(--line);
    background:
      radial-gradient(40rem 22rem at 12% 0%, rgba(233, 185, 85, 0.2), transparent 65%),
      var(--paper-3);
  }

  .reviews__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .reviews h2 {
    margin-top: 1.1rem;
    font-size: clamp(2.1rem, 4.6vw, 3.5rem);
  }

  .reviews h2 em {
    font-style: italic;
    color: var(--jam);
  }

  .rating {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(251, 246, 234, 0.6);
  }

  .rating__score {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--ink);
  }

  .rating__body {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .rating__stars {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--jam);
  }

  .rating__meta {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(92, 69, 56, 0.85);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 2.8rem;
  }

  .quote {
    position: relative;
    margin: 0;
    padding: 0.4rem clamp(1.2rem, 3vw, 2.4rem) 0.4rem 0;
  }

  .quote + .quote {
    padding-left: clamp(1.2rem, 3vw, 2.4rem);
    border-left: 1px dashed var(--line-strong);
  }

  .quote__mark {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: 3.2rem;
    line-height: 0.6;
    color: var(--butter);
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 45, 'WONK' 0, 'opsz' 28;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.45;
    color: var(--ink);
    text-wrap: pretty;
  }

  .quote__author {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.2rem;
  }

  .quote__avatar {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    background: var(--butter);
    color: var(--crust);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .quote__author strong {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
  }

  .quote__meta {
    display: block;
    font-size: 0.7rem;
    color: rgba(92, 69, 56, 0.8);
  }

  .reviews__note {
    margin-top: 2.2rem;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--line);
    font-size: 0.72rem;
    color: rgba(92, 69, 56, 0.78);
  }

  @media (max-width: 860px) {
    .reviews__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.4rem;
    }

    .quotes {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .quote {
      padding: 0;
    }

    .quote + .quote {
      padding: 1.5rem 0 0;
      border-left: 0;
      border-top: 1px dashed var(--line-strong);
    }
  }
</style>
