---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header" data-header>
  <div class="container header__inner">
    <a class="brand" href={`${base}/`} aria-label="Berlinas, ir al inicio">
      <span class="brand__name">Berlinas</span>
      <span class="brand__sub">obrador de barrio</span>
    </a>

    <nav class="nav" aria-label="Secciones de la página">
      <a href="#obrador">El obrador</a>
      <a href="#vitrina">La vitrina</a>
      <a href="#visitanos">Visítanos</a>
    </nav>

    <div class="header__actions">
      <a
        class="header__ig"
        href={site.contact.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de Berlinas (se abre en una pestaña nueva)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7" />
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.7" />
          <circle cx="17.2" cy="6.8" r="1.15" fill="currentColor" />
        </svg>
      </a>
      <a class="btn btn--butter header__cta" href="#encargos">Haz un encargo</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(246, 237, 220, 0.82);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    transition:
      border-color 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }

  .site-header.is-scrolled {
    background: rgba(251, 246, 234, 0.92);
    border-bottom-color: var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.4rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1;
    text-decoration: none;
    color: var(--ink);
  }

  .brand__name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 900;
    font-variation-settings: 'SOFT' 80, 'WONK' 1, 'opsz' 90;
    font-size: 1.72rem;
    letter-spacing: -0.035em;
    transform: translateY(1px);
  }

  .brand__sub {
    margin-top: 0.28rem;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--jam);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.1rem);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .nav a {
    position: relative;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.3rem;
    width: 100%;
    height: 1.5px;
    background: var(--jam);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .nav a:hover {
    color: var(--ink);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .header__ig {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .header__ig svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .header__ig:hover {
    background: var(--ink);
    color: var(--paper-2);
  }

  .header__cta {
    padding: 0.72rem 1.15rem;
    font-size: 0.84rem;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .header__inner {
      gap: 0.75rem;
      min-height: 4rem;
    }

    .brand__name {
      font-size: 1.5rem;
    }

    .brand__sub {
      display: none;
    }

    .header__cta {
      padding: 0.66rem 1rem;
      font-size: 0.78rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (header) {
    const update = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
