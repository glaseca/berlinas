---
import { site } from '../data/site';

const mapSrc =
  'https://www.openstreetmap.org/export/embed.html?bbox=-3.7120%2C40.4202%2C-3.6962%2C40.4296&layer=mapnik&marker=40.4250%2C-3.7040';
---

<section class="section visit" id="visitanos" aria-labelledby="visit-title">
  <div class="container">
    <div class="visit__head">
      <p class="eyebrow reveal">03 — Visítanos</p>
      <h2 class="reveal" id="visit-title" style="--reveal-delay: 60ms">
        Nos encontrarás<br /><em>por el olor.</em>
      </h2>
      <p class="visit__intro reveal" style="--reveal-delay: 120ms">
        En pleno Malasaña, a un paso del mercado. Entra, pide un café y mira qué
        ha salido del horno esta mañana.
      </p>
    </div>

    <div class="visit__grid">
      <div class="visit__map reveal">
        <iframe
          src={mapSrc}
          title="Mapa con la ubicación de Berlinas en Malasaña, Madrid"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>

        <div class="visit__map-card">
          <span class="visit__map-label">Estamos aquí</span>
          <strong>{site.address.street}</strong>
          <span>{site.address.postal}</span>
        </div>
      </div>

      <div class="visit__info reveal" style="--reveal-delay: 120ms">
        <div class="info-block">
          <h3>Dirección</h3>
          <p>
            {site.address.street}<br />
            {site.address.postal} · {site.neighbourhood}
          </p>
          <a
            class="link-arrow"
            href={site.address.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Abrir en el mapa <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="info-block">
          <h3>Horario</h3>
          <dl class="hours">
            {site.hours.map((slot) => (
              <div class:list={['hours__row', { 'hours__row--closed': slot.closed }]}>
                <dt>{slot.days}</dt>
                <dd>{slot.hours}</dd>
              </div>
            ))}
          </dl>
          <p class="info-note">Si hay cola, es buena señal.</p>
        </div>

        <div class="info-block">
          <h3>Habla con nosotros</h3>
          <ul class="contact-list">
            <li>
              <a href={site.contact.phoneHref}>
                <span class="contact-list__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M6.6 3.5h2.2l1.5 4.1-2 1.4a12 12 0 0 0 6.7 6.7l1.4-2 4.1 1.5v2.2a2.6 2.6 0 0 1-2.8 2.6A17.6 17.6 0 0 1 4 6.3 2.6 2.6 0 0 1 6.6 3.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                </span>
                {site.contact.phoneDisplay}
              </a>
            </li>
            <li>
              <a href={`mailto:${site.contact.email}`}>
                <span class="contact-list__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {site.contact.email}
              </a>
            </li>
            <li>
              <a
                href={site.contact.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="contact-list__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.15" fill="currentColor"/></svg>
                </span>
                {site.contact.instagram}
              </a>
            </li>
          </ul>
        </div>

        <p class="visit__metro">
          Metro Tribunal o Bilbao · 3 minutos andando
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .visit__head {
    max-width: 46rem;
  }

  .visit h2 {
    margin-top: 1.1rem;
    font-size: clamp(2.2rem, 4.8vw, 3.7rem);
  }

  .visit h2 em {
    font-style: italic;
    color: var(--jam);
  }

  .visit__intro {
    margin-top: 1.15rem;
    max-width: 40ch;
    font-size: 1.02rem;
  }

  .visit__grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 1.4rem;
    margin-top: 2.6rem;
  }

  .visit__map {
    position: relative;
    min-height: 30rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--paper-3);
    box-shadow: var(--shadow);
  }

  .visit__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 30rem;
    border: 0;
    filter: sepia(0.16) saturate(0.92) contrast(0.98);
  }

  .visit__map-card {
    position: absolute;
    left: 1rem;
    top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.8rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(251, 246, 234, 0.95);
    box-shadow: 0 16px 34px -22px rgba(46, 26, 17, 0.6);
    font-size: 0.8rem;
    line-height: 1.35;
    color: rgba(92, 69, 56, 0.85);
    backdrop-filter: blur(6px);
  }

  .visit__map-card strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .visit__map-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--jam);
  }

  .visit__info {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    padding: clamp(1.4rem, 2.6vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--paper-2);
  }

  .info-block + .info-block {
    padding-top: 1.35rem;
    border-top: 1px dashed var(--line-strong);
  }

  .info-block h3 {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--jam);
  }

  .info-block p {
    margin-top: 0.5rem;
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.55rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration-color: var(--butter);
    text-decoration-thickness: 2px;
  }

  .link-arrow:hover {
    color: var(--jam);
  }

  .hours {
    display: grid;
    gap: 0.4rem;
    margin: 0.65rem 0 0;
  }

  .hours__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.82rem;
  }

  .hours__row dt {
    color: rgba(92, 69, 56, 0.85);
  }

  .hours__row dd {
    margin: 0;
    font-weight: 700;
    color: var(--ink);
    text-align: right;
  }

  .hours__row--closed dd {
    color: var(--jam);
    font-weight: 600;
    font-style: italic;
  }

  .info-note {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.85rem !important;
    color: rgba(92, 69, 56, 0.85) !important;
  }

  .contact-list {
    display: grid;
    gap: 0.5rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .contact-list a:hover {
    color: var(--jam);
  }

  .contact-list__icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--paper);
  }

  .contact-list__icon svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .visit__metro {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px dashed var(--line);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: rgba(92, 69, 56, 0.8);
  }

  @media (max-width: 900px) {
    .visit__grid {
      grid-template-columns: 1fr;
    }

    .visit__map,
    .visit__map iframe {
      min-height: 24rem;
    }
  }

  @media (max-width: 560px) {
    .visit__map,
    .visit__map iframe {
      min-height: 19rem;
    }

    .visit__map-card {
      left: 0.7rem;
      top: 0.7rem;
    }
  }
</style>
